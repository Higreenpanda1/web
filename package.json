{
  "name": "higreenpanda-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HiGreenPanda — Arabic-first bilingual marketing site for a China trade-services company. Next.js + Payload CMS + PostgreSQL.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/run.ts",
    "totp:enrol": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/enrol-totp.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-resend": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/translations": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "dotenv": "^16.6.1",
    "graphql": "16.14.2",
    "lucide-react": "0.469.0",
    "next": "15.4.11",
    "next-intl": "4.3.12",
    "payload": "3.90.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.4.11",
    "playwright": "^1.56.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "graphql": "16.14.2"
  }
}
