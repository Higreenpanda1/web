{
  "name": "higreenpanda-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HiGreenPanda — Arabic-first bilingual marketing site for a China trade-services company. Next.js + Payload CMS + PostgreSQL.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/run.ts",
    "totp:enrol": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/enrol-totp.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:e2e": "node tests/e2e.mjs",
    "prestart": "mkdir -p .next/standalone/public .next/standalone/.next && cp -r public/. .next/standalone/public/ && cp -r .next/static .next/standalone/.next/",
    "test:admin": "node --experimental-strip-types tests/admin-gate.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-resend": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/translations": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "graphql": "16.14.2",
    "lucide-react": "0.469.0",
    "next": "15.4.11",
    "next-intl": "4.14.5",
    "payload": "3.90.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "eslint-config-next": "15.4.11",
    "playwright": "1.63.0",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "dotenv": "17.4.2"
  },
  "overrides": {
    "graphql": "16.14.2"
  },
  "browserslist": [
    "> 0.5% in AE",
    "> 0.5% in SA",
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 Firefox versions",
    "last 2 ChromeAndroid versions",
    "last 2 iOS versions",
    "not dead"
  ]
}
