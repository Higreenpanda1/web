# ─────────────────────────────────────────────────────────────────────────────
# HiGreenPanda — environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------
# Public origin of the site, no trailing slash. Used for canonicals, hreflang,
# sitemap, OG images and the Payload serverURL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# The domain Caddy serves in production. Only read by docker-compose.prod.yml.
SITE_DOMAIN=higreenpanda.com

# Payload's signing secret for auth tokens. Rotating this logs everyone out.
PAYLOAD_SECRET=change-me-openssl-rand-base64-32

# --- Database ---------------------------------------------------------------
# PostgreSQL 16. The docker-compose stack provides this host name.
DATABASE_URI=postgres://higreenpanda:change-me@localhost:5432/higreenpanda
POSTGRES_USER=higreenpanda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=higreenpanda

# --- Admin security ---------------------------------------------------------
# The admin panel lives at /hgp-studio, not /admin. Changing this path means
# renaming src/app/(payload)/hgp-studio/ to match — see DEPLOY.md §"Admin path".
#
# Require a TOTP second factor for every admin login (recommended: true).
# Enrol an admin with:  npm run totp:enrol -- admin@higreenpanda.com
ADMIN_REQUIRE_2FA=true

# Space-separated CIDRs allowed to reach /hgp-studio, enforced by Caddy before
# the request reaches the app. The default allows everyone, so a first deploy
# cannot lock you out; narrow it once you know the addresses you work from.
# Example: ADMIN_IP_ALLOWLIST_CADDY=203.0.113.4/32 198.51.100.0/24
ADMIN_IP_ALLOWLIST_CADDY=0.0.0.0/0

# Where uploaded media is written. Defaults to ./media next to the app.
# In Docker this is a mounted volume so a redeploy never loses it.
MEDIA_DIR=

# --- Email (transactional) --------------------------------------------------
# Enquiry notifications must not depend on the higreenpanda.com mail server.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=website@higreenpanda.com
EMAIL_FROM_NAME=HiGreenPanda
# Where enquiry notifications are delivered (comma-separated).
ENQUIRY_NOTIFY_TO=contact@higreenpanda.com

# --- Analytics (self-hosted Plausible or Umami; no cookie banner needed) -----
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=higreenpanda.com

# --- Error reporting --------------------------------------------------------
# Set this to have errors reported rather than discovered. Wiring a reporter in
# is a small change to src/app/(frontend)/[locale]/error.tsx; nothing reads it
# yet, so leaving it empty changes nothing.
SENTRY_DSN=

# --- Off-server backups (S3-compatible: Hetzner Object Storage, R2, B2) -----
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Seeding ----------------------------------------------------------------
# Used only by `npm run seed` to create the first admin user.
SEED_ADMIN_EMAIL=admin@higreenpanda.com
SEED_ADMIN_PASSWORD=

# --- Blog automation ----------------------------------------------------------
# All optional. Each integration switches on when its value is set and is
# silent otherwise. See HANDOVER.md → "The blog".
#
# IndexNow: tells Bing, Yandex, Naver and Seznam about new articles at once.
# Any 8–128 hex characters; make one with:  openssl rand -hex 16
INDEXNOW_KEY=

# Metricool: schedules one social post per network when an article goes live.
# Token from Metricool → Settings → API. The ids are this brand's (HANDOVER.md).
METRICOOL_TOKEN=
METRICOOL_USER_ID=4648321
METRICOOL_BLOG_ID=6019177
METRICOOL_NETWORKS=facebook,instagram
METRICOOL_TIMEZONE=Asia/Shanghai
# "false" sends a notification to the Metricool phone app to post by hand.
METRICOOL_AUTOPUBLISH=true

# Claude: writes key takeaways and questions for articles that lack them,
# translates Arabic-only articles into English, and drafts one new article a
# week from the content queue. Drafts are never published automatically.
ANTHROPIC_API_KEY=
# Model for the content jobs. Default is the most capable current model.
ANTHROPIC_MODEL=claude-opus-5
# How many articles the nightly enrichment job processes (default 3).
ENRICH_BATCH=3
# Weekday for the draft job, 0 = Sunday … 6 = Saturday (default 1, Monday).
DRAFT_WEEKDAY=1

# Set to "off" to stop all background jobs (they are on by default in production).
AUTOMATION=on
